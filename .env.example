# Local development uses SQLite and ./uploads automatically.
# Generate a real key with: npx emdash secrets generate --write .env
EMDASH_ENCRYPTION_KEY=replace-with-a-generated-secret

# Production database (PostgreSQL provider connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# S3-compatible media storage (Cloudflare R2 is one supported option)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=your-media-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=auto

# Optional: enables GitHub sign-in in the EmDash admin panel
EMDASH_OAUTH_GITHUB_CLIENT_ID=replace-me
EMDASH_OAUTH_GITHUB_CLIENT_SECRET=replace-me
