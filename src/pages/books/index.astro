---
import BaseLayout from '../../layouts/BaseLayout.astro';
import bookData from '../../data/books.json';
const books = bookData.books;
const authorStore = 'https://www.amazon.com/Books-Ahmed-Oubali/s?rh=n%3A283155%2Cp_27%3AAhmed%2BOubali';
---
<BaseLayout title="Libros de Ahmed Oubali | Catálogo" description="Libros de Ahmed Oubali: catálogo de novelas, narrativa policial y estudios literarios con enlaces a las ediciones disponibles." keywords={["libros Ahmed Oubali","obras de Ahmed Oubali","novelas negras","narrativa policial","libros de semiótica","ensayos literarios"]}>
  <main class="catalog">
    <header class="catalog-head"><p class="eyebrow">Biblioteca editorial</p><h1>Libros de Ahmed Oubali</h1><p>Explora el catálogo de obras narrativas y estudios literarios. Cada ficha reúne una descripción y un enlace a la edición comercial correspondiente cuando está disponible.</p><div class="catalog-summary"><strong>{books.length}</strong><span>títulos en el catálogo</span></div><a class="store-button" href={authorStore} target="_blank" rel="noopener noreferrer">Ver todos los libros en Amazon ↗</a></header>
    <div class="book-grid">{books.map((book)=><article class="book-card"><div class="cover"><span>Ahmed Oubali</span><strong>{book.title}</strong><small>{book.year}</small></div><div class="book-info"><p class="eyebrow">{book.category} · {book.year}</p><h2><a href={import.meta.env.BASE_URL+'books/'+book.slug+'/'}>{book.title}</a></h2><p class="book-description">{book.description}</p><div class="book-actions"><a class="more" href={import.meta.env.BASE_URL+'books/'+book.slug+'/'}>Ver ficha del libro</a><a class="amazon-button" href={book.amazonUrl} target="_blank" rel="noopener noreferrer">Ver en Amazon ↗</a></div></div></article>)}</div>

  </main>
  </BaseLayout>
<style>
.catalog{max-width:1248px;min-height:65vh;margin:auto;padding:clamp(3rem,7vw,5rem) 1.5rem 6rem}.catalog-head{max-width:760px;margin:0 auto 3rem;text-align:center}.catalog-head h1{margin:.5rem 0;color:var(--ink);font:700 clamp(2.4rem,6vw,4rem)/1.1 'Playfair Display',serif}.catalog-head p:not(.eyebrow){color:var(--muted);line-height:1.8}.catalog-summary{display:inline-flex;align-items:center;gap:.7rem;margin-top:1rem;padding:.65rem 1rem;border:1px solid var(--line);border-radius:2rem;background:var(--surface)}.catalog-summary strong{color:var(--gold-deep);font:600 1.25rem 'Playfair Display',serif}.catalog-summary span{color:var(--muted);font-size:.75rem}.store-button,.amazon-button{display:inline-flex;align-items:center;justify-content:center;gap:.35rem;border-radius:2rem;background:#2c150b;color:#f3d77d;padding:.7rem 1rem;font-size:.78rem;font-weight:800;text-decoration:none}.store-button{margin-top:1.2rem}.book-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:1.2rem}.book-card{display:grid;grid-template-columns:112px minmax(0,1fr);min-height:235px;overflow:hidden;border:1px solid var(--line);border-radius:.9rem;background:var(--surface);transition:transform .2s ease,box-shadow .2s ease}.book-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-soft)}.cover{display:flex;flex-direction:column;justify-content:space-between;padding:1rem .8rem;background:linear-gradient(145deg,#51483a,#8a7655);color:#f5e8c9;text-align:center}.cover span,.cover small{font-size:.58rem;letter-spacing:.08em}.cover strong{font:700 1rem 'Playfair Display',serif;line-height:1.2}.book-info{align-self:center;min-width:0;padding:1.1rem}.book-info h2{color:var(--ink);font:700 1.05rem 'Playfair Display',serif;line-height:1.35}.book-info h2 a{color:inherit;text-decoration:none}.book-description{color:var(--muted);font-size:.8rem;line-height:1.65}.book-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;margin-top:.8rem}.more{display:inline-block;color:var(--crimson);font-size:.75rem;font-weight:800;text-decoration:none}
@media(max-width:430px){.book-card{grid-template-columns:92px minmax(0,1fr)}.book-info{padding:.8rem}.cover{padding:.8rem .55rem}}
</style>