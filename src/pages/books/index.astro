---
import BaseLayout from '../../layouts/BaseLayout.astro';
import books from '../../data/books.json';
---
<BaseLayout title="Libros de Ahmed Oubali | Amazon" description="Catálogo de libros de Ahmed Oubali en Amazon."><main class="catalog"><header class="catalog-head"><p class="eyebrow">Biblioteca editorial</p><h1>Libros de Ahmed Oubali</h1><p>Explora las obras y consulta cada ficha para acceder a su edición en Amazon.</p></header><div class="book-grid">{books.map((book)=><article class="book-card"><div class="cover"><span>Ahmed Oubali</span><strong>{book.title}</strong><small>{book.year}</small></div><div class="book-info"><p class="eyebrow">{book.category} · {book.year}</p><h2><a href={import.meta.env.BASE_URL+'books/'+book.slug+'/'}>{book.title}</a></h2><a class="more" href={import.meta.env.BASE_URL+'books/'+book.slug+'/'}>Ver ficha del libro →</a></div></article>)}</div></main></BaseLayout>
<style>.catalog{max-width:1180px;margin:auto;padding:5rem 1.5rem 7rem}.catalog-head{max-width:700px;margin:0 auto 3rem;text-align:center}.catalog-head h1{font:700 clamp(2.4rem,6vw,4rem) 'Playfair Display',serif;color:#2c150b;margin:.5rem 0}.catalog-head p:not(.eyebrow){color:#75665c;line-height:1.7}.eyebrow{text-transform:uppercase;letter-spacing:.15em;color:#8b0000;font-size:.68rem;font-weight:700}.book-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.4rem}.book-card{background:white;border:1px solid #e9e1d8;border-radius:1rem;overflow:hidden;display:grid;grid-template-columns:112px 1fr;min-height:210px}.cover{background:linear-gradient(145deg,#32190e,#68402b);color:#e9d59d;padding:1rem .8rem;display:flex;flex-direction:column;justify-content:space-between;text-align:center;box-shadow:inset 5px 0 12px #1c0e08}.cover span,.cover small{font-size:.58rem;letter-spacing:.08em}.cover strong{font:700 1rem 'Playfair Display',serif;line-height:1.2}.book-info{padding:1rem;align-self:center}.book-info h2{font:700 1.05rem 'Playfair Display',serif;color:#2c150b;line-height:1.35}.book-info h2 a{color:inherit;text-decoration:none}.more{font-size:.75rem;color:#8b0000;font-weight:700;text-decoration:none}</style>