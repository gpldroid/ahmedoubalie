---
import BaseLayout from '../../layouts/BaseLayout.astro';
import books from '../../data/books.json';
export function getStaticPaths(){return books.map((book)=>({params:{slug:book.slug},props:{book}}));}
const {book}=Astro.props;
---
<BaseLayout title={book.title+' | Ahmed Oubali'} description={book.description}><main class="detail"><a class="back" href={import.meta.env.BASE_URL+'books/'}>← Volver al catálogo</a><article><div class="detail-cover"><span>Ahmed Oubali</span><strong>{book.title}</strong><small>{book.year}</small></div><div><p class="eyebrow">{book.category} · {book.year}</p><h1>{book.title}</h1><p class="description">{book.description}</p><p class="note">La disponibilidad, el formato y los datos de esta edición pueden variar según el marketplace de Amazon.</p><a class="amazon-button" href={book.amazonUrl} target="_blank" rel="noopener noreferrer">Consultar en Amazon ↗</a><p class="asin">Identificador de edición: {book.asin}</p></div></article></main></BaseLayout>
<style>.detail{max-width:1000px;margin:auto;padding:4rem 1.5rem 7rem}.back{color:#8b0000;text-decoration:none;font-size:.85rem;font-weight:700}.detail article{display:grid;grid-template-columns:minmax(220px,320px) 1fr;gap:clamp(2rem,7vw,5rem);align-items:center;margin:3rem auto}.detail-cover{aspect-ratio:3/4;background:linear-gradient(145deg,#32190e,#68402b);color:#e9d59d;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;text-align:center;box-shadow:12px 15px 30px #2c150b30,inset 7px 0 14px #1c0e08}.detail-cover span,.detail-cover small{font-size:.75rem;letter-spacing:.1em}.detail-cover strong{font:700 clamp(1.5rem,4vw,2.5rem) 'Playfair Display',serif;line-height:1.15}.eyebrow{font-size:.7rem;text-transform:uppercase;letter-spacing:.15em;color:#8b0000;font-weight:700}.detail h1{font:700 clamp(2.2rem,5vw,3.5rem) 'Playfair Display',serif;color:#2c150b;line-height:1.1}.description{color:#66574e;line-height:1.8}.note{font-size:.8rem;color:#887b72;line-height:1.6}.amazon-button{display:inline-flex;background:#2c150b;color:#f3d77d;padding:1rem 1.4rem;border-radius:2rem;text-decoration:none;font-weight:700;margin-top:1rem}.asin{font-size:.7rem;color:#9a8e85;margin-top:1.2rem}@media(max-width:650px){.detail article{grid-template-columns:1fr}.detail-cover{max-width:280px;margin:auto;width:100%}}</style>