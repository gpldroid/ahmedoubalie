<script is:inline>
// 1. Mobile Menu Toggle Event Listener
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }

        // 2. Book Modal Logic
        function openBookModal(title, description, category) {
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-description').textContent = description;
            document.getElementById('modal-category').textContent = category.toUpperCase();
            document.getElementById('book-modal').classList.remove('hidden');
        }

        function closeBookModal() {
            document.getElementById('book-modal').classList.add('hidden');
        }

        // 3. Work Category Filter Logic
        function filterWorks(category) {
            const cards = document.querySelectorAll('.work-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // 4. PDF Search Logic
        function filterPDFs() {
            const query = document.getElementById('pdf-search-input').value.toLowerCase();
            const pdfItems = document.querySelectorAll('.pdf-item');
            pdfItems.forEach(item => {
                const title = item.querySelector('.pdf-title').textContent.toLowerCase();
                if (title.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // 5. Contact Form Handler
        function handleContactSubmit(e) {
            e.preventDefault();
            const successBox = document.getElementById('contact-success');
            if (successBox) {
                successBox.classList.remove('hidden');
                e.target.reset();
                setTimeout(() => {
                    successBox.classList.add('hidden');
                }, 4000);
            }
        }

        // 6. Gemini AI Integration for Literary Summaries
        async function generateAILiterarySummary() {
            const box = document.getElementById('ai-response-box');
            const contentDiv = document.getElementById('ai-text-content');
            const btn = document.getElementById('ai-btn');

            box.classList.remove('hidden');
            contentDiv.innerHTML = '<div class="flex items-center gap-3 text-stone-400 text-xs"><i class="fa-solid fa-spinner fa-spin text-brand-gold text-lg"></i> Analizando el perfil intelectual con Gemini AI...</div>';
            btn.disabled = true;

            const prompt = "Genera un análisis sintético y elegante en español sobre el perfil intelectual y literario del Profesor y Novelista marroquí Ahmed Oubali. Resalta su faceta como precursor del relato noir policiaco (Chivos Expiatorios, Narcolepsia), su labor en la semiótica (La danza de los signos), la enseñanza de 5 idiomas (español, francés, inglés, alemán, árabe) y sus obras en PDF. Usa un tono académico y distinguido.";

            try {
                const apiKey = ""; // API key populated dynamically
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });

                const result = await response.json();
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;

                if (text) {
                    const formattedText = text.split('\n\n').map(p => `<p class="leading-relaxed">${p}</p>`).join('');
                    contentDiv.innerHTML = formattedText;
                } else {
                    contentDiv.innerHTML = '<p class="text-stone-400">No se pudo generar la síntesis en este momento. Por favor reintente más tarde.</p>';
                }
            } catch (error) {
                console.error(error);
                contentDiv.innerHTML = '<p class="text-stone-400">Error al consultar el servicio de Inteligencia Artificial.</p>';
            } finally {
                btn.disabled = false;
            }
        }
    
</script>
</main></BaseLayout>