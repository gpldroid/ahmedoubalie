---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import LanguagesSection from '../components/LanguagesSection.astro';
import WorksSection from '../components/WorksSection.astro';
import PdfLibrarySection from '../components/PdfLibrarySection.astro';
import LiteraryAssistantSection from '../components/LiteraryAssistantSection.astro';
import ContactSection from '../components/ContactSection.astro';
import BookModal from '../components/BookModal.astro';
---
<BaseLayout title="Ahmed Oubali | Escritor, hispanista y docente" description="Sitio oficial de Ahmed Oubali: novelas de intriga, literatura marroquí en español, semiótica, crítica literaria y docencia de idiomas." keywords={['Ahmed Oubali','escritor marroquí','hispanista','novela negra','literatura marroquí en español','semiótica literaria','crítica literaria','docencia de idiomas','narrativa policial']}>
  <main id="main-content">
    <HeroSection />
    <AboutSection />
    <LanguagesSection />
    <WorksSection />
    <PdfLibrarySection />
    <LiteraryAssistantSection />
    <ContactSection />
    <BookModal />
  </main>
</BaseLayout>
