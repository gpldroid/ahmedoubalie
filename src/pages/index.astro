---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import LanguagesSection from '../components/LanguagesSection.astro';
import WorksSection from '../components/WorksSection.astro';
import PdfLibrarySection from '../components/PdfLibrarySection.astro';
import LiteraryAssistantSection from '../components/LiteraryAssistantSection.astro';
import ContactSection from '../components/ContactSection.astro';
import BookModal from '../components/BookModal.astro';
---
<BaseLayout>
  <main id="main-content">
    <HeroSection />
    <AboutSection />
    <LanguagesSection />
    <WorksSection />
    <PdfLibrarySection />
    <LiteraryAssistantSection />
    <ContactSection />
    <BookModal />
  </main>
</BaseLayout>

<script>
  const modal = document.querySelector('#book-modal');
  let previousFocus: HTMLElement | null = null;

  const closeBookModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');
    previousFocus?.focus();
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const filterButton = target.closest<HTMLButtonElement>('[data-work-filter]');
    if (filterButton) {
      const category = filterButton.dataset.workFilter ?? 'all';
      document.querySelectorAll<HTMLElement>('.work-card').forEach((card) => {
        card.hidden = category !== 'all' && card.dataset.category !== category;
      });
      document.querySelectorAll<HTMLButtonElement>('[data-work-filter]').forEach((button) => {
        const active = button === filterButton;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      return;
    }

    const openButton = target.closest<HTMLButtonElement>('[data-book-open]');
    if (openButton && modal) {
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      const title = modal.querySelector<HTMLElement>('#modal-title');
      const description = modal.querySelector<HTMLElement>('#modal-description');
      const category = modal.querySelector<HTMLElement>('#modal-category');
      if (title) title.textContent = openButton.dataset.title ?? '';
      if (description) description.textContent = openButton.dataset.description ?? '';
      if (category) category.textContent = (openButton.dataset.category ?? '').toUpperCase();
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      modal.querySelector<HTMLButtonElement>('[data-modal-close]')?.focus();
      return;
    }

    if (target.closest('[data-modal-close]') || target === modal) {
      closeBookModal();
      return;
    }

    if (target.closest('[data-summary-open]')) {
      document.querySelector('#ai-response-box')?.classList.remove('hidden');
      return;
    }

    if (target.closest('[data-summary-close]')) {
      document.querySelector('#ai-response-box')?.classList.add('hidden');
    }
  });

  document.querySelector<HTMLInputElement>('#pdf-search-input')?.addEventListener('input', (event) => {
    const query = (event.currentTarget as HTMLInputElement).value.trim().toLocaleLowerCase();
    let visibleCount = 0;
    document.querySelectorAll<HTMLElement>('.pdf-item').forEach((item) => {
      const title = item.querySelector('.pdf-title')?.textContent?.toLocaleLowerCase() ?? '';
      const visible = title.includes(query);
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    document.querySelector('#pdf-empty-state')?.classList.toggle('hidden', visibleCount > 0);
  });

  document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    document.querySelector('#contact-notice')?.classList.remove('hidden');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeBookModal();
      document.querySelector('#ai-response-box')?.classList.add('hidden');
    }
  });
</script>