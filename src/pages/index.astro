---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import LanguagesSection from '../components/LanguagesSection.astro';
import WorksSection from '../components/WorksSection.astro';
import PdfLibrarySection from '../components/PdfLibrarySection.astro';
import LiteraryAssistantSection from '../components/LiteraryAssistantSection.astro';
import ContactSection from '../components/ContactSection.astro';
import BookModal from '../components/BookModal.astro';
---
<BaseLayout><main>

    

        <HeroSection />

        <AboutSection />

        <LanguagesSection />

        <WorksSection />

        <PdfLibrarySection />



        <LiteraryAssistantSection />

        <ContactSection />

    <!-- Footer -->
    

    <BookModal />

    <script is:inline>
// Book modal controls
        let lastFocusedElement = null;
        function openBookModal(title, description, category) {
            const modal = document.getElementById('book-modal');
            if (!modal) return;
            lastFocusedElement = document.activeElement;
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-description').textContent = description;
            document.getElementById('modal-category').textContent = category.toUpperCase();
            modal.classList.remove('hidden');
            modal.setAttribute('aria-hidden', 'false');
            modal.querySelector('button')?.focus();
        }

        function closeBookModal() {
            const modal = document.getElementById('book-modal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.setAttribute('aria-hidden', 'true');
            lastFocusedElement?.focus?.();
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && document.getElementById('book-modal')?.getAttribute('aria-hidden') === 'false') {
                closeBookModal();
            }
        });

        // 3. Work Category Filter Logic
        function filterWorks(category) {
            const cards = document.querySelectorAll('.work-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // 4. PDF Search Logic
        function filterPDFs() {
            const query = document.getElementById('pdf-search-input')?.value?.trim().toLowerCase() ?? '';
            const pdfItems = document.querySelectorAll('.pdf-item');
            let visibleCount = 0;
            pdfItems.forEach(item => {
                const title = item.querySelector('.pdf-title')?.textContent?.toLowerCase() ?? '';
                if (title.includes(query)) {
                    item.style.display = 'flex';
                    visibleCount += 1;
                } else {
                    item.style.display = 'none';
                }
            });
            document.getElementById('pdf-empty-state')?.classList.toggle('hidden', visibleCount !== 0);
        }

        // Static site: no mail endpoint is configured, so never report a false success.
        function handleContactSubmit(e) {
            e.preventDefault();
            const notice = document.getElementById('contact-notice');
            if (notice) notice.classList.remove('hidden');
        }

        // Local editorial summary; no API key or third-party request is required.
        function generateAILiterarySummary() {
            const box = document.getElementById('ai-response-box');
            const content = document.getElementById('ai-text-content');
            if (!box || !content) return;
            content.textContent = 'Ahmed Oubali vincula la narrativa noir y policiaca con la investigación semiótica y la crítica literaria. Sus publicaciones exploran el relato de intriga, la construcción de la identidad y los signos culturales en la literatura marroquí en lengua española. Su actividad docente abarca español, francés, inglés, alemán y árabe. Esta síntesis es editorial y estática; no se genera mediante un servicio de inteligencia artificial.';
            box.classList.remove('hidden');
        }

    </script>
</main></BaseLayout>