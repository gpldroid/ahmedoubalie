---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomTabBar from '../components/BottomTabBar.astro';
import '../styles/global.css';
const {
  title = 'Ahmed Oubali | Escritor, profesor e hispanista',
  description = 'Sitio oficial de Ahmed Oubali: literatura, investigación semiótica, docencia y publicaciones.',
  keywords = [],
  noindex = false,
  pageSchema = null,
} = Astro.props;
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const siteUrl = Astro.site ? new URL(root, Astro.site).toString() : undefined;
const routeSuffix = Astro.url.pathname.split('/').filter(Boolean).join('/');
const routePath = Astro.url.pathname.startsWith(root) ? Astro.url.pathname : root + (routeSuffix ? routeSuffix + (Astro.url.pathname.endsWith('/') ? '/' : '') : '');
const canonical = Astro.site ? new URL(routePath, Astro.site).toString() : undefined;
const socialImage = Astro.site ? new URL(root + 'images/social-card.svg', Astro.site).toString() : undefined;
const socialLinks = [
  'https://ahmedoubali.blogspot.com',
  'https://m.facebook.com/ahmed.oubali/',
  'https://www.linkedin.com/in/ahmed-oubali-97ab2554/fr/',
  'https://www.amazon.com/Books-Ahmed-Oubali/s?rh=n%3A283155%2Cp_27%3AAhmed%2BOubali',
];
const seoTitle = title.length > 60 ? title.slice(0, 57).trimEnd() + '…' : title;
const seoDescription = description.length > 155 ? description.slice(0, 152).trimEnd() + '…' : description;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': siteUrl ? siteUrl + '#author' : undefined,
      name: 'Ahmed Oubali',
      url: siteUrl,
      jobTitle: ['Escritor', 'Hispanista', 'Docente', 'Investigador literario'],
      knowsLanguage: ['es', 'fr', 'en', 'de', 'ar'],
      sameAs: socialLinks,
    },
    {
      '@type': 'WebSite',
      '@id': siteUrl ? siteUrl + '#website' : undefined,
      name: 'Ahmed Oubali',
      url: siteUrl,
      inLanguage: 'es',
      publisher: siteUrl ? { '@id': siteUrl + '#author' } : undefined,
    },
    {
      '@type': 'WebPage',
      name: seoTitle,
      description: seoDescription,
      url: canonical,
      inLanguage: 'es',
      isPartOf: siteUrl ? { '@id': siteUrl + '#website' } : undefined,
      about: siteUrl ? { '@id': siteUrl + '#author' } : undefined,
      mainEntity: pageSchema || undefined,
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="bCaxiNDGk6j_tbXkQc80TSNqVjOe2oR16eMmmRZQMLA" />
    <meta name="description" content={seoDescription} />
    <meta name="theme-color" content="#252a34" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="author" content="Ahmed Oubali" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Ahmed Oubali" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="Ahmed Oubali — escritor, hispanista y docente" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta name="twitter:card" content="summary_large_image" />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    {siteUrl && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{seoTitle}</title>
    <link rel="icon" type="image/svg+xml" href={root + 'favicon.svg'} />
    <link rel="shortcut icon" href={root + 'favicon.svg'} />
    <link rel="mask-icon" href={root + 'favicon.svg'} color="#b18b52" />
    <link rel="manifest" href={root + 'site.webmanifest'} />
    <link rel="sitemap" type="application/xml" href={root + 'sitemap.xml'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Header />
    <slot />
    <Footer />
    <BottomTabBar />
    <script>
      const modal = document.querySelector('#book-modal');
      let previousFocus: HTMLElement | null = null;
      const closeBookModal = () => {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
        previousFocus?.focus();
      };
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const filterButton = target.closest<HTMLButtonElement>('[data-work-filter]');
        if (filterButton) {
          const category = filterButton.dataset.workFilter ?? 'all';
          document.querySelectorAll<HTMLElement>('.publication-card').forEach((card) => { card.hidden = category !== 'all' && card.dataset.category !== category; });
          document.querySelectorAll<HTMLButtonElement>('[data-work-filter]').forEach((button) => {
            const active = button === filterButton; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active));
          });
          return;
        }
        const openButton = target.closest<HTMLButtonElement>('[data-book-open]');
        if (openButton && modal) {
          previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          const title = modal.querySelector<HTMLElement>('#modal-title');
          const description = modal.querySelector<HTMLElement>('#modal-description');
          const category = modal.querySelector<HTMLElement>('#modal-category');
          if (title) title.textContent = openButton.dataset.title ?? '';
          if (description) description.textContent = openButton.dataset.description ?? '';
          if (category) category.textContent = (openButton.dataset.category ?? '').toUpperCase();
          modal.classList.remove('hidden'); modal.setAttribute('aria-hidden', 'false');
          modal.querySelector<HTMLButtonElement>('[data-modal-close]')?.focus(); return;
        }
        if (target.closest('[data-modal-close]') || target === modal) { closeBookModal(); return; }
        if (target.closest('[data-summary-open]')) { document.querySelector('#ai-response-box')?.classList.remove('hidden'); return; }
        if (target.closest('[data-summary-close]')) document.querySelector('#ai-response-box')?.classList.add('hidden');
      });
      document.querySelector<HTMLInputElement>('#pdf-search-input')?.addEventListener('input', (event) => {
        const query = (event.currentTarget as HTMLInputElement).value.trim().toLocaleLowerCase();
        let visibleCount = 0;
        document.querySelectorAll<HTMLElement>('.pdf-item').forEach((item) => {
          const title = item.querySelector('.pdf-title')?.textContent?.toLocaleLowerCase() ?? '';
          const visible = title.includes(query); item.hidden = !visible; if (visible) visibleCount += 1;
        });
        document.querySelector('#pdf-empty-state')?.classList.toggle('hidden', visibleCount > 0);
      });
      document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (event) => {
        event.preventDefault(); document.querySelector('#contact-notice')?.classList.remove('hidden');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { closeBookModal(); document.querySelector('#ai-response-box')?.classList.add('hidden'); }
      });
    </script>
  </body>
</html>
