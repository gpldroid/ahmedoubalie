---
import SocialIcons from './SocialIcons.astro';
import Icon3D from './Icon3D.astro';
const root = import.meta.env.BASE_URL;
const links = [
  { label: 'Inicio', href: root, key: 'inicio' },
  { label: 'Biografía', href: root + 'sobre-mi/', key: 'sobre-mi' },
  { label: 'Idiomas', href: root + 'idiomas/', key: 'idiomas' },
  { label: 'Publicaciones', href: root + 'publicaciones/', key: 'publicaciones' },
  { label: 'Biblioteca PDF', href: root + 'biblioteca-pdf/', key: 'biblioteca-pdf' },
  { label: 'Libros', href: root + 'books/', key: 'books' },
  { label: 'Asistente', href: root + 'asistente-literario/', key: 'asistente-literario' }
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\/+|\/+$/g, '');
---
<nav class="site-nav" aria-label="Navegación principal">
  <div class="nav-inner">
    <a class="brand" href={root} aria-label="Ahmed Oubali, inicio">
      <span class="brand-mark" aria-hidden="true">AO</span>
      <span><strong>Ahmed Oubali</strong><small>Escritor · Hispanista · Docente</small></span>
    </a>
    <div class="nav-links">
      {links.map((item) => <a href={item.href} aria-current={path === item.key || (!path && item.key === 'inicio') ? 'page' : undefined}>{item.label}</a>)}
      <SocialIcons />
      <a class="contact-link" href={root + 'contacto/'}>Contacto <Icon3D name="mail" /></a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"><Icon3D name="menu" /></button>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    {links.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={root + 'contacto/'}>Contacto</a><SocialIcons />
  </div>
</nav>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#mobile-menu');
  const closeMenu = () => { menu?.setAttribute('hidden', ''); toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Abrir menú'); };
  toggle?.addEventListener('click', () => {
    const shouldOpen = menu?.hasAttribute('hidden') ?? false;
    if (shouldOpen) { menu?.removeAttribute('hidden'); toggle?.setAttribute('aria-expanded', 'true'); toggle?.setAttribute('aria-label', 'Cerrar menú'); }
    else closeMenu();
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeMenu(); toggle?.focus(); } });
  window.addEventListener('resize', () => { if (window.innerWidth > 900) closeMenu(); });
</script>
