---
import SocialIcons from './SocialIcons.astro';
const root = import.meta.env.BASE_URL;
---
<nav class="site-nav"><div class="nav-inner"><a class="brand" href={root}><span class="brand-mark">AO</span><span><strong>Ahmed Oubali</strong><small>Escritor y catedrático políglota</small></span></a><button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">☰</button><div class="nav-links"><a href={root+"#about"}>Biografía</a><a href={root+"#languages"}>Idiomas</a><a href={root+"#works"}>Obras</a><a href={root+"#pdf-library"}>Biblioteca PDF</a><a href={root+"books/"}>Libros en Amazon</a><SocialIcons/><a class="contact-link" href={root+"#contact"}>Contacto</a></div></div><div id="mobile-menu" class="mobile-menu" hidden><a href={root+"#about"}>Biografía</a><a href={root+"#languages"}>Idiomas</a><a href={root+"#works"}>Obras</a><a href={root+"#pdf-library"}>Biblioteca PDF</a><a href={root+"books/"}>Libros en Amazon</a><SocialIcons/></div></nav>
<script>
const toggle = document.querySelector('.menu-toggle');
const menu = document.querySelector('#mobile-menu');
toggle?.addEventListener('click', () => { const open = menu?.hasAttribute('hidden'); if(open) menu?.removeAttribute('hidden'); else menu?.setAttribute('hidden',''); toggle?.setAttribute('aria-expanded', String(open)); });
</script>
<style>
.site-nav{position:sticky;top:0;z-index:50;background:#fffffff0;backdrop-filter:blur(14px);border-bottom:1px solid #e7e1d9}.nav-inner{max-width:1280px;margin:auto;padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}.brand{display:flex;align-items:center;gap:.8rem;color:#2c150b;text-decoration:none}.brand-mark{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#2c150b;color:#d4af37;font-family:Georgia,serif;font-size:1.2rem}.brand strong,.brand small{display:block}.brand strong{font:700 1.35rem Georgia,serif}.brand small{font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:#8b0000;margin-top:.25rem}.nav-links{display:flex;align-items:center;gap:1.1rem;font-size:.85rem}.nav-links>a,.mobile-menu>a{color:#51443d;text-decoration:none}.nav-links>a:hover,.mobile-menu>a:hover{color:#8b0000}.contact-link{background:#2c150b;color:#d4af37!important;padding:.65rem 1rem;border-radius:2rem}.menu-toggle{display:none;background:none;border:0;font-size:1.5rem;color:#2c150b}.mobile-menu{padding:0 1.5rem 1.2rem;gap:.8rem}.mobile-menu:not([hidden]){display:grid}@media(max-width:900px){.nav-links{display:none}.menu-toggle{display:block}}
</style>