---
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const tabs = [
  { label: 'Inicio', href: root, key: '', icon: 'fa-house' },
  { label: 'Biografía', href: root + 'sobre-mi/', key: 'sobre-mi', icon: 'fa-user' },
  { label: 'Publicaciones', href: root + 'publicaciones/', key: 'publicaciones', icon: 'fa-book-open' },
  { label: 'Libros', href: root + 'books/', key: 'books', icon: 'fa-book' },
  { label: 'Contacto', href: root + 'contacto/', key: 'contacto', icon: 'fa-envelope' },
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').split('/').filter(Boolean).join('/');
---
<nav class="bottom-tab-bar" aria-label="Navegación rápida">
  {tabs.map((tab) => (
    <a href={tab.href} class:list={['bottom-tab', (path === tab.key || (tab.key && path.startsWith(tab.key + '/'))) && 'is-active']} aria-current={(path === tab.key || (tab.key && path.startsWith(tab.key + '/'))) ? 'page' : undefined}>
      <i class:list={['fa-solid', tab.icon]} aria-hidden="true"></i>
      <span>{tab.label}</span>
    </a>
  ))}
</nav>
