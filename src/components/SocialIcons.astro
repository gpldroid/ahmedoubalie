---
import links from '../data/social-links.json';
---
<div class="social-links">{links.map((item)=><a href={item.url} target="_blank" rel="noopener noreferrer" title={item.label} aria-label={item.label} class={item.class}><i class={item.icon} aria-hidden="true"></i></a>)}</div>
<style>.social-links{display:flex;align-items:center;gap:.8rem}.social-links a{font-size:1.15rem;text-decoration:none;transition:transform .2s ease}.social-links a:hover{transform:translateY(-2px)}.blogger{color:#C2410C}.facebook{color:#1558B0}.linkedin{color:#0A66C2}.amazon{color:#8A4B00}.site-footer .blogger{color:#FF7A45}.site-footer .facebook{color:#6EA8FF}.site-footer .linkedin{color:#62A7F5}.site-footer .amazon{color:#FFB454}</style>