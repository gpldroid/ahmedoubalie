<div id="book-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-description" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-xl w-full p-8 relative shadow-2xl space-y-6">
            <button type="button" aria-label="Cerrar detalles del libro" onclick="closeBookModal()" class="absolute top-6 right-6 text-stone-400 hover:text-stone-800 text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <span id="modal-category" class="inline-block px-3 py-1 bg-brand-gold/20 text-brand-800 text-xs font-bold rounded-full uppercase">Categoría</span>
            <h3 id="modal-title" class="text-2xl font-serif font-bold text-stone-900">Título de la Obra</h3>
            <p id="modal-description" class="text-stone-600 text-sm leading-relaxed">Descripción detallada de la obra...</p>
            <div class="pt-4 border-t border-stone-200 flex justify-end gap-3">
                <button type="button" onclick="closeBookModal()" class="px-5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold text-stone-700">Cerrar</button>
                <a href="#pdf-library" onclick="closeBookModal()" class="px-5 py-2.5 rounded-xl bg-brand-crimson text-white text-xs font-semibold hover:bg-red-900 transition">Ver Biblioteca PDF</a>
            </div>
        </div>
    </div>