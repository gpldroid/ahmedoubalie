<div id="book-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-description" aria-hidden="true" tabindex="-1" class="book-modal hidden">
  <div class="book-modal-panel">
    <button type="button" data-modal-close aria-label="Cerrar detalles del libro" class="modal-x">×</button>
    <span id="modal-category" class="modal-category">Categoría</span>
    <h3 id="modal-title">Título de la obra</h3>
    <p id="modal-description">Descripción detallada de la obra.</p>
    <div class="modal-actions">
      <button type="button" data-modal-close class="modal-close">Cerrar</button>
      <a href={import.meta.env.BASE_URL + '#pdf-library'} data-modal-close class="modal-library">Ver biblioteca PDF</a>
    </div>
  </div>
</div>